import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# --- Configuration ---
# Find the latest log file automatically
# or you can specify a filename like "mission_log_final.csv"
LOG_FILE = "mission_log_final.csv"


def load_data(filepath):
    if not os.path.exists(filepath):
        print(f"Error: Log file '{filepath}' not found!")
        print("Please run the NAO controller first to generate data.")
        return None

    # Read CSV
    df = pd.read_csv(filepath)
    print(f"Data loaded: {len(df)} rows.")
    return df


def plot_emotion_accuracy(df):
    """
    Chart 1: Emotion Recognition Confidence Distribution (Boxplot)
    Shows how confident the model was for each emotion.
    """
    plt.figure(figsize=(8, 6))
    sns.set_theme(style="whitegrid")

    # Boxplot of Confidence by Emotion
    sns.boxplot(x="Emotion", y="Confidence", data=df, palette="Set2")
    sns.swarmplot(x="Emotion", y="Confidence", data=df, color=".25", size=3)

    plt.title("Emotion Recognition Confidence Distribution")
    plt.ylim(0, 1.1)
    plt.ylabel("Model Confidence Score")
    plt.savefig("plot_1_emotion_accuracy.png")
    print("Saved plot_1_emotion_accuracy.png")
    plt.show()


def plot_action_distribution(df):
    """
    Chart 2: Action Trigger Count (Bar Chart)
    Shows how many times each action was triggered.
    """
    plt.figure(figsize=(8, 6))

    # Count actions (filter out 'Patrol' if you want only reactions)
    action_counts = df["Action"].value_counts()

    sns.barplot(x=action_counts.index, y=action_counts.values, palette="viridis")

    plt.title("Robot Action Response Count")
    plt.ylabel("Count")
    plt.xlabel("Action Type")
    plt.xticks(rotation=45)
    plt.savefig("plot_2_action_counts.png")
    print("Saved plot_2_action_counts.png")
    plt.show()


def plot_reaction_timeline(df):
    """
    Chart 3: Reaction Timeline (Line Chart)
    Shows Confidence and Action triggers over time.
    """
    plt.figure(figsize=(10, 6))

    # Calculate relative time (start from 0)
    start_time = df["Time"].iloc[0]
    df["Rel_Time"] = df["Time"] - start_time

    # Plot Confidence Line
    sns.lineplot(
        x="Rel_Time",
        y="Confidence",
        data=df,
        label="Detection Confidence",
        color="blue",
    )

    # Mark Actions on the line
    # Filter rows where Action is NOT Patrol (meaning a reaction happened)
    reactions = df[df["Action"] != "Patrol"]
    plt.scatter(
        reactions["Rel_Time"],
        reactions["Confidence"],
        color="red",
        zorder=5,
        label="Action Triggered",
    )

    # Annotate action names
    for _, row in reactions.iterrows():
        plt.text(
            row["Rel_Time"],
            row["Confidence"] + 0.02,
            row["Action"],
            fontsize=9,
            rotation=45,
        )

    plt.title("System Response Timeline")
    plt.xlabel("Time (seconds)")
    plt.ylabel("Confidence Level")
    plt.legend()
    plt.grid(True)
    plt.savefig("plot_3_response_timeline.png")
    print("Saved plot_3_response_timeline.png")
    plt.show()


if __name__ == "__main__":
    # 1. Load Data
    # Find the newest csv in current folder (mission_log_*.csv)
    all_files = [
        f
        for f in os.listdir(".")
        if f.startswith("mission_log") and f.endswith(".csv")
    ]

    if all_files:
        latest_file = max(all_files, key=os.path.getctime)
        print(f"Analyzing latest log: {latest_file}")

        data = load_data(latest_file)

        if data is not None and not data.empty:
            # 2. Generate Plots
            plot_emotion_accuracy(data)
            plot_action_distribution(data)
            plot_reaction_timeline(data)
        else:
            print("CSV file is empty or invalid.")
    else:
        print("No log files found!")
