import os

# Stop the tensorflow red warning text， it is annoying！！！！！！
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'

import cv2
import numpy as np
import socket
import json
import time
import tensorflow as tf
from tensorflow.keras.models import load_model

# --- Config ---
# The model file from my teammate.
# Make sure this file is in the same folder!!!
MODEL_PATH = 'emotion_model_ver4.h5'

# Localhost Webots
WEBOTS_IP = "127.0.0.1"
WEBOTS_PORT = 5005

# Input size for the model (Checked with teammate， use 96)
IMG_SIZE = 96

# Label definition
LABELS_LIST = ['Angry', 'Disgust', 'Fear', 'Happy', 'Sad', 'Surprise', 'Neutral']

# Map string to ID for the robot controller
# Note: We don't have actions for Disgust, we have action for Fear and Surprise but these are hardly to distinguish
EMOTION_TO_ID = {
    'Neutral': 0,
    'Disgust': 0,
    'Fear': 0,
    'Surprise': 0,
    'Happy': 1,
    'Angry': 2,
    'Sad': 3
}

# --- Load Model ---
print("Loading Keras model... please wait.")
try:
    model = load_model(MODEL_PATH, compile=False)
    print(">>> Model V4 loaded successfully.")
except Exception as e:
    print("!!! Error: Cannot load model.")
    print(e)
    # exit() # Don't exit， let me see the error

# --- Main Loop ---
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

# Use opencv default xml for face detection
# If error here， check cv2 installation.
face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')

cap = cv2.VideoCapture(0)

print(">>> Camera on. Press 'q' to quit.")
last_send_time = 0

while True:
    ret, frame = cap.read()
    if not ret:
        print("Camera error?")
        break

    # Gray scale for detection
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # 1.3 scale factor is faster
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    current_id = 0  # Default is Neutral
    detected_str = "Scanning..."

    for (x, y, w, h) in faces:
        # Draw box
        cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)

        try:
            # Cut the face out
            face_roi = gray[y:y + h, x:x + w]

            # Resize to model input size
            resized = cv2.resize(face_roi, (IMG_SIZE, IMG_SIZE))

            # Check model channel (Gray or RGB)
            # My teammate change the model structure many times， so I check here.
            if model.input_shape[-1] == 3:
                resized = cv2.cvtColor(resized, cv2.COLOR_GRAY2RGB)
            else:
                resized = np.expand_dims(resized, axis=-1)

            # Normalize 0-1
            normalized = resized.astype('float32') / 255.0
            input_data = np.expand_dims(normalized, axis=0)

            # Predict
            preds = model.predict(input_data, verbose=0)
            label_idx = np.argmax(preds)
            detected_str = LABELS_LIST[label_idx]

            # Get ID
            current_id = EMOTION_TO_ID.get(detected_str, 0)

            # Show text on screen
            text = detected_str + " -> " + str(current_id)
            cv2.putText(frame, text, (x, y - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2)

        except Exception as e:
            # print("Processing error")
            pass

    # --- Send to Webots ---
    # Don't send too fast， or the robot will lag.
    # 0.1s interval
    if time.time() - last_send_time > 0.1:
        # manual mapping for safety
        id_to_str = {0: "Neutral", 1: "Happy", 2: "Angry", 3: "Sad"}
        final_emotion_str = id_to_str.get(current_id, "Neutral")

        payload = {
            "emotion": final_emotion_str,
            "rl_id": current_id
        }

        # JSON dump
        msg = json.dumps(payload).encode('utf-8')
        sock.sendto(msg, (WEBOTS_IP, WEBOTS_PORT))
        last_send_time = time.time()

        if current_id != 0:
            print("Sending: " + final_emotion_str + " (ID: " + str(current_id) + ")")

    cv2.imshow('Camera View', frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
