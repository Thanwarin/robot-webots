from stable_baselines3 import PPO
# Make sure the env file is in the same folder!!!
from nao_env_6emo import Nao6EmotionEnv
import os

# 1. Create Environment
env = Nao6EmotionEnv()

# 2. Create PPO Agent
# Use PPO because it is stable as the name says haha
print("Init 6-Emotion RL agent...")
model = PPO("MlpPolicy", env, verbose=1)

# 3. Start Training
# I tested 10000 steps， accurate is low. 20000 seems better.
print("Start training...")
model.learn(total_timesteps=20000)

# 4. Save Model
model_name = "nao_6emo_policy"
model.save(model_name)

print("Training finished.")
print("Model saved as: " + model_name + ".zip")
print("Don't forget to copy this zip to Webots controller folder!!")
